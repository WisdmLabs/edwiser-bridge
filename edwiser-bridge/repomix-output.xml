     */
    public function eb_register_course_routes()
    {
        register_rest_route(self::API_NAMESPACE, '/courses', array(
            'methods'  => WP_REST_Server::READABLE,
            'callback' => array($this, 'eb_get_courses'),
            'permission_callback' => '__return_true',
            'args' => array(
                'page' => array(
