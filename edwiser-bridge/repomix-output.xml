/* Enrollment test progress */
.enroll-progress {
  display: none;
  counter-reset: step;
}
.enroll-progress li {
  list-style-type: none;
  width: 25%;
  float: left;
  font-size: 12px;
  position: relative;
  /* text-align: center; */
}
.enroll-progress li:before {
  content: counter(step);
  width: 20px;
  height: 20px;
  line-height: 20px;
  counter-increment: step;
  background-color: white;
  border: 1px solid #ddd;
  border-radius: 50%;
  display: block;
  text-align: center;
  margin: 0 0 10px 0;
}
.enroll-progress li:after {
  content: '';
  position: absolute;
  width: 100%;
  height: 3px;
  background-color: #ddd;
  top: 10px;
  left: -100%;
  z-index: -1;
}
.enroll-progress li:first-child:after {
  content: none;
}
.enroll-progress li.active {
  color: green;
}
.enroll-progress li.active:before {
  border-color: green;
  background-color: green;
  color: white;
}
.enroll-progress li.active::after {
  background-color: green;
}
.enroll-progress li.in-progress:before {
  background-color: #d6d6d6;
}
.enroll-progress li.in-progress::after {
  background-color: green;
}
