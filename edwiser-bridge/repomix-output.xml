		if (isset($_SERVER['SERVER_SOFTWARE'])) {
			$server = strtolower($_SERVER['SERVER_SOFTWARE']);
			if (strpos($server, 'apache') !== false) {
				$htaccess_file = ABSPATH . '.htaccess';
