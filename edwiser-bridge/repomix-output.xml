  direction: rtl;
}

.rtl.react-multiple-carousel__arrow--right {
  right: auto;
  left: 4px;
}

.rtl.react-multiple-carousel__arrow--right::before {
  content: '\f104';
}

.rtl.react-multiple-carousel__arrow--left {
  left: auto;
  right: 4px;
