			if ( $license_key ) {
				$responce = $this->send_license_request( $license_key, 'deactivate_license' );
				if ( false === $responce['status'] ) {
					return $responce;
				}
				$license_data = $responce['data'];
				if ( 'deactivated' === $license_data->license || 'failed' === $license_data->license ) {
