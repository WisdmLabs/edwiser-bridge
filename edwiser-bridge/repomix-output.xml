      "type": "number",
      "default": 9
    },
    "categories": {
      "type": "string"
    },
    "groupByCategory": {
      "type": "boolean",
      "default": false
    },
    "categoryPerPage": {
      "type": "number",
      "default": 3
    },
    "horizontalScroll": {
      "type": "boolean",
      "default": false
    }
  },
  "textdomain": "edwiser-bridge",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
