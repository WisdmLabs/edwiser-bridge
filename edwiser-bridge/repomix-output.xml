              label={__('Enable horizontal slider', 'edwiser-bridge')}
              checked={attributes.horizontalScroll}
              onChange={(value) => setAttributes({ horizontalScroll: value })}
            />
          </fieldset>
        </PanelBody>
      </InspectorControls>
      <CourseListing {...attributes} />
    </div>
  );
